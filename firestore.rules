rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admins and Partners
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "dr.ahmad.alfailakawi@gmail.com" ||
        request.auth.token.email == "volcanokw@gmail.com"
      );
    }
    
    function isPartner() {
      return request.auth != null && (
        request.auth.token.email == "mfq241188@gmail.com"
      );
    }
    
    function isAuthorized() {
      return isAdmin() || isPartner();
    }

    match /{document=**} {
      allow read, write: if isAuthorized();
    }

    // Client App Access
    match /products/{productId} {
      allow read: if true;
    }
    match /app_products/{productId} {
      allow read: if true;
    }
    match /regions/{regionId} {
      allow read: if true;
    }
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true; // In a production app, we would restrict this by token or phone, but for simplicity here we allow reading by ID/Query
      allow update: if true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentMethod']) && request.resource.data.status == 'paid';
    }
    match /invoices/{invoiceId} {
      allow read: if true; // To check payment status
      allow update: if true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'paymentId', 'verifiedByBackend', 'verificationError']) && request.resource.data.paymentStatus == 'paid';
    }
  }
}
