# WhatsApp Web bridge — local configuration template.
# install-mac.command copies this file to .env (which is git-ignored).
# Put real values ONLY in .env. Never commit .env or paste the secret anywhere.

# --- Required -------------------------------------------------------------

# HTTPS base URL of the admin Cloud Run service (no trailing slash).
ALTURATH_BRIDGE_BASE_URL=https://your-admin-service.example.com

# Shared secret; must be identical to WHATSAPP_BRIDGE_SECRET on the admin
# Cloud Run service and at least 64 characters. Generate one with:
#   node generate-secret.mjs
# Autostart mode may leave this empty and resolve it at start-up instead
# (see the WHATSAPP_SECRET_* options below).
WHATSAPP_BRIDGE_SECRET=

# --- Optional (defaults shown; uncomment to override) ---------------------

# Device id reported to the server; also names the session profile folder.
# WHATSAPP_BRIDGE_DEVICE_ID=alturath-mac-main

# Folder holding the linked-device session (relative to this folder).
# WHATSAPP_SESSION_PATH=.session

# Outbox poll interval in ms (500-10000).
# WHATSAPP_POLL_INTERVAL_MS=1200

# Ignore chat history older than this at start-up, in seconds (0-1800).
# WHATSAPP_STARTUP_HISTORY_GRACE_SECONDS=120

# Skip automatic outbox items older than this, in minutes (1-1440).
# WHATSAPP_MAX_AUTO_OUTBOX_AGE_MINUTES=15

# true/false switches.
# WHATSAPP_MARK_READ=true
# WHATSAPP_IGNORE_GROUPS=true
# WHATSAPP_IGNORE_STATUS=true
# WHATSAPP_POLL_RECENT_CHATS=false
# WHATSAPP_WARM_LID_ALIASES=true

# --- Autostart service (service-runner.mjs) only --------------------------

# Log rotation: max bytes per log file and number of rotated files to keep.
# WHATSAPP_LOG_MAX_BYTES=5242880
# WHATSAPP_LOG_KEEP_FILES=5

# Tool paths, if not on the default locations.
# GCLOUD_BIN=/opt/homebrew/share/google-cloud-sdk/bin/gcloud
# NPM_BIN=

# Resolve WHATSAPP_BRIDGE_SECRET at start-up with gcloud when it is not set
# above: either PROJECT + SERVICE + REGION (reads the Cloud Run service env),
# or PROJECT + NAME (reads Secret Manager).
# WHATSAPP_SECRET_PROJECT=
# WHATSAPP_SECRET_SERVICE=
# WHATSAPP_SECRET_REGION=
# WHATSAPP_SECRET_NAME=
